# Homeserver / local Postgres. When this is set and SUPABASE_SECRET_KEY is
# unset, the app talks to Postgres directly (Bun.sql), stores users itself,
# and writes export ZIPs to EXPORTS_DIR.
DATABASE_URL=postgres://nutrition:nutrition@127.0.0.1:5432/nutrition

# Password for the Compose-managed Postgres. docker-compose.yml builds
# DATABASE_URL from it, so change both together (`openssl rand -hex 16`).
POSTGRES_PASSWORD=nutrition

# Public origin Claude.ai and export download links must advertise.
# Cloudflare Tunnel hostname, no trailing slash.
PUBLIC_BASE_URL=https://mcp.example.com

# Directory for export ZIPs (Postgres mode). Default: ./exports
EXPORTS_DIR=./exports

# Hosted production still uses these instead of DATABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-secret-key

OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# Google login (optional). When unset, only email/password sign-in is available.
# Postgres mode verifies ID tokens with Google directly — no Supabase provider.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Open Food Facts requires a User-Agent identifying your app + contact, in the
# form "AppName (email)". Used for barcode lookups (lookup_barcode tool).
OFF_USER_AGENT=nutrition-mcp (you@example.com)

PORT=8080

# Browser MCP clients (ChatGPT web, Inspector). Claude.ai's connector typically
# sends no Origin. Include your PUBLIC_BASE_URL if you open the login page in a
# browser on a non-localhost host.
# ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# USDA FoodData Central. Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Only needed for generic whole-food lookup and `bun run validate:usda`.
USDA_FDC_API_KEY=
